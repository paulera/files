#!/bin/bash

find . -type f \( -name "*.php" -o -name "*.js" \) -print0 | xargs -0 awk '
  FNR==1 { file=FILENAME; printed_header=0 }
  /TODO:/ {
    grab=1
    startline=FNR
    line=$0
    sub(/^[ \t]*\*[ \t]?/, "", line)
    sub(/^TODO:[ \t]*/, "", line)
    buf=line
    next
  }
  grab {
    if ($0 ~ /\*\//) {
      if (!printed_header) {
        if (any_output) print ""
        print "=== " file ": ==="
        print ""
        printed_header=1
      } else {
        print ""
      }
      count++
      printf "* TASK %03d (line %d):\n%s\n", count, startline, buf
      any_output=1
      grab=0
      next
    }
    line=$0
    sub(/^[ \t]*\*[ \t]?/, "", line)
    if (line != "") buf = buf " " line
    next
  }
'


